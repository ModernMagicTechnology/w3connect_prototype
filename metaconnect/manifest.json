{
  "name": "MetaConnect (Local Wallet Bridge)",
  "description": "Injects a local EIP-1193 provider for approved sites and forwards requests to a local HTTP wallet.",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html"
}
